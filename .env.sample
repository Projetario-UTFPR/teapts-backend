# App
APP_NAME=TEA PTS
APP_DOMAIN=localhost
APP_URL=http://${APP_DOMAIN}:3000
APP_VERSION=

PORT=3000
## develpoment | production | test
NODE_ENV=development

# JWT
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
## Uma lista de audiências separadas por vírgula. Veja: https://datatracker.ietf.org/doc/html/rfc7519#section-4.1.3.
JWT_AUDIENCE= 

# Database
DB_USER=docker
DB_PASSWORD=docker
DB_NAME=teapts
DB_DOMAIN=localhost
DB_PORT=5432

DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_DOMAIN}:${DB_PORT}/${DB_NAME}?schema=public"

# Blob Storage
BLOB_STORAGE_SERVER_DOMAINS=${APP_DOMAIN}
BLOB_STORAGE_CONSOLE_ENABLE=true
BLOB_STORAGE_PORT=9000
# Never add trailing slashes (i.e.: 'http://127.0.0.1:9000/' will fail)
# Also avoid localhost in favor of 127.0.0.1 (rustfs forbids localhost domain)
BLOB_STORAGE_URL="http://127.0.0.1:${BLOB_STORAGE_PORT}"
BLOB_STORAGE_ACCESS_KEY="rustfs"
BLOB_STORAGE_SECRET_KEY="rustfs"
BLOB_STORAGE_REGION="sa-east-1"
## BUCKETS
DOCUMENTS_BUCKET=
PROFILE_PICTURES_BUCKET=