# Some non-sensitive environment variables to be set in the test workflows
# Some environment variables must be set directly to github secrets
APP_NAME=TEA PTS
APP_DOMAIN=localhost
APP_URL=http://${APP_DOMAIN}:3000
APP_VERSION=test

PORT=3000
## develpoment | production | test
NODE_ENV=test

# JWT stuff are set on github secrets
# DB env vars are set by postgresql container factory

BLOB_STORAGE_ACCESS_KEY = "test_rustfs";
BLOB_STORAGE_SECRET_KEY = "test_rustfs";
# other blob storage env vars are set by rustfs container factory
